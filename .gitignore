# Go binaries and build output
*.exe
*.exe~
*.test
*.out
coverage.out
coverage.html
/bin/
/dist/
installer/bin/
installer/dist/
**/cli/bin/
**/cli/dist/
**/cli/cli
**/cli/cli.exe
release-assets/
vendor/

# go.work is committed on purpose: this is a multi-module repo and
# contributors need a shared workspace for the IDE to resolve pkg/ locally.

# Environment / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Fonts are downloaded by `make fonts` and embedded at build time via go:embed.
# Release CI re-downloads them; they are not source.
skills/social-carousel/cli/templates/fonts/*.woff2
skills/social-carousel/cli/templates/fonts/*.ttf

# Skill-root bin/ (some skills install via `make install-local`).
skills/*/bin/

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Stray binary from `go build ./...` (Go names it after the package directory)
installer/installer
