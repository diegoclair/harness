{{- /*
  list.html.tmpl — Slide layout: NUMBERED LIST
  ---------------------------------------------
  Fields used:
    .Slide.Label  string   — optional uppercase eyebrow above the title
    .Slide.Title  string   — slide title, dominant (optional but recommended)
    .Slide.Items  []string — list items, ≤5 per slide (L1)

  Spec rules (D §4 List):
    L1: items_per_slide <= 5
    L2: badge 48–60px with item number (we use 60×60px)
    L3: item_font_size >= 36px
    L4: gap_between_items >= 24px (we use 32px)

  Layout: eyebrow + title at top → numbered badges + text list below.
  The title is set larger/heavier than items so it clearly leads (a title
  the same size as its items reads as auto-generated). Dividers use the
  accent tint so they stay visible on both dark and light tones.
*/ -}}
{{define "layout-list"}}
{{- $count := len .Slide.Items -}}
<style>
  .list-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: var(--footer-reserve, 120px);
    gap: 56px;
  }

  .list-head {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .list-eyebrow {
    font-family: var(--font-body);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }

  .list-title {
    font-family: var(--font-heading);
    font-size: 84px;            /* dominant — clearly leads the items below */
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--fg-primary);   /* tone scopes redefine --fg-primary (see base.css) */
    max-width: 920px;
  }

  .list-items {
    display: flex;
    flex-direction: column;
    gap: 32px;                  /* L4: gap >= 24px */
    list-style: none;
  }

  /* Item font scales with item count so short lists fill more vertical
     space without crowding longer ones. */
  .list-items[data-count="1"] .list-item__text,
  .list-items[data-count="2"] .list-item__text { font-size: 56px; }
  .list-items[data-count="3"] .list-item__text { font-size: 52px; }
  .list-items[data-count="4"] .list-item__text { font-size: 48px; }
  .list-items[data-count="5"] .list-item__text { font-size: 44px; }

  .list-item {
    display: flex;
    align-items: flex-start;
    gap: 28px;
  }

  .list-item__badge {
    flex-shrink: 0;
    width: 60px;                /* L2: 48–60px */
    height: 60px;
    border-radius: 50%;
    background-color: var(--accent);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0;
    line-height: 1;
    margin-top: 2px;            /* optical alignment with first line of text */
  }

  .list-item__text {
    font-family: var(--font-body);
    font-size: 44px;            /* Research E §5: 36→44 (mobile ~15pt). L3 floor: 36px. */
    font-weight: 500;
    line-height: 1.3;
    color: var(--fg-primary);   /* tone scopes redefine --fg-primary (see base.css) */
    max-width: 820px;
  }

  /* Divider between items — accent tint stays visible on any tone
     (the old neutral grey vanished on both dark and light backgrounds). */
  .list-item + .list-item {
    padding-top: 32px;
    border-top: 2px solid color-mix(in srgb, var(--accent) 32%, transparent);
  }
</style>

<div class="list-content">
  {{- if or .Slide.Label .Slide.Title }}
  <div class="list-head">
    {{- if .Slide.Label }}
    <p class="list-eyebrow">{{ .Slide.Label }}</p>
    {{- end }}
    {{- if .Slide.Title }}
    <h2 class="list-title">{{ highlight .Slide.Title }}</h2>
    {{- end }}
  </div>
  {{- end }}

  <ul class="list-items" data-count="{{ $count }}">
    {{- range $i, $item := .Slide.Items }}
    <li class="list-item">
      <span class="list-item__badge">{{ printf "%02d" (add1 $i) }}</span>
      <span class="list-item__text">{{ highlight $item }}</span>
    </li>
    {{- end }}
  </ul>
</div>

{{template "footer" .}}
{{end}}
